# =============================================================
#  SV KI-Lotse — environment template
#  Copy to .env and fill in:   cp .env.example .env
#  .env is gitignored. Never put real keys in this file.
#  docker compose reads .env from this folder automatically.
# =============================================================

# ---------- App ----------
# development | demo | production
APP_ENV=development
# DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO
# Signs session cookies for the mock login. Generate:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me

# ---------- LLM provider ----------
# eustella = primary | azure = fallback | fake = scripted | replay = recorded replies
# LLM_PROVIDER=replay funktioniert ohne API-Schlüssel und ohne Netzwerk.
LLM_PROVIDER=replay
# Record live LLM responses for the offline demo. Never record real personal data.
LLM_RECORD=false
# Directory for recorded LLM responses, relative to the process working directory.
LLM_FIXTURES_DIR=demo/fixtures
# Replay pacing: recorded answers stream like live ones. 0 turns pacing off.
# Demo values: 900 ms first token, 110 characters per second.
LLM_REPLAY_FIRST_TOKEN_MS=0
LLM_REPLAY_CHARS_PER_SECOND=0
# Upper limit for the pacing delay of one model call, in seconds.
LLM_REPLAY_MAX_SECONDS=12
# Where an unrecorded request goes in replay mode: fake, eustella or azure.
# eustella lets the jury ask free questions; it needs a valid EUSTELLA_API_KEY.
LLM_REPLAY_FALLBACK=fake

# ---------- LLM: eustella (OpenAI-compatible) ----------
EUSTELLA_API_KEY=rk_your_key_here
EUSTELLA_BASE_URL=https://api.eustella.com/v1
EUSTELLA_MODEL=eustella-v1.5
# Reasoning counts toward max_tokens. Below ~4096 replies can come back empty.
LLM_MAX_TOKENS=4096
# false = faster first token for plain chat turns. Document analysis can override per call.
LLM_ENABLE_THINKING=false
# Text extraction defaults to thinking off. Images always use thinking.
DOCUMENT_EXTRACTION_THINKING=false
LLM_TIMEOUT_SECONDS=120
# retries on 429/503, honouring Retry-After
LLM_MAX_RETRIES=2
# Explorer tier allows 2 calls at once for the whole organisation.
LLM_MAX_CONCURRENCY=2
# Max tool rounds per agent turn.
LLM_MAX_TOOL_ROUNDS=3

# ---------- LLM: organisers' Azure OpenAI (fallback) ----------
# Endpoint and key come from the organisers. Never commit them.
AZURE_OPENAI_BASE_URL=https://your-endpoint.services.ai.azure.com/openai/v1
AZURE_OPENAI_API_KEY=your_azure_key_here
AZURE_OPENAI_MODEL=gpt-5-4-mini
# low | medium | high
AZURE_REASONING_EFFORT=low

# ---------- Guardrails ----------
# Second LLM call that checks replies for medical advice. Costs one request per turn.
GUARDRAIL_OUTPUT_CHECK=false

# ---------- Embeddings (local, runs inside the backend) ----------
# Small and fast (384 dims). Stronger option: intfloat/multilingual-e5-large (1024 dims).
EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
EMBEDDING_DIM=384
EMBEDDING_CACHE_DIR=/models
RAG_TOP_K=5

# ---------- Database: Postgres + pgvector ----------
POSTGRES_USER=lotse
POSTGRES_PASSWORD=change-me
POSTGRES_DB=lotse
# "db" inside docker compose, "localhost" when running the backend natively
POSTGRES_HOST=db
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_HOST}:${POSTGRES_PORT}/${POSTGRES_DB}

# ---------- Backend (FastAPI) ----------
BACKEND_PORT=8000
# Native server port override. Compose uses BACKEND_PORT inside the container.
PORT=8000
# Comma-separated origins allowed to call the API. Must contain the frontend origin
# (http://localhost:<frontend port>). Compose derives it from FRONTEND_PORT when unset.
BACKEND_CORS_ORIGINS=http://localhost:3000
UPLOAD_DIR=/data/uploads
MAX_UPLOAD_MB=10
# Local OCR (Tesseract via PyMuPDF) for scans and photos. Off: images go to the vision model.
OCR_ENABLED=true
# Tesseract languages, joined with +.
OCR_LANGUAGES=deu+eng
# Tesseract language folder. Leave empty to detect it automatically.
OCR_TESSDATA_DIR=
OCR_TIMEOUT_SECONDS=60
# Minimum similarity (0-100) for a quote in OCR text to count as verified.
OCR_QUOTE_MIN_SIMILARITY=90

# ---------- Frontend (Next.js) ----------
# Frontend port for compose and Playwright. A PORT set in the shell wins for npm scripts.
FRONTEND_PORT=3000
# WARNING: every NEXT_PUBLIC_* value is shipped to the browser. Never put secrets here.
# Backend URL as the browser sees it. Next.js inlines it at build time: rebuild after a change.
# Use the same host name as the frontend (both localhost). Else the browser does not send
# the SameSite=Lax session cookie.
NEXT_PUBLIC_API_URL=http://localhost:8000
# Timeout in ms for one REST request and for the stream until the response headers arrive.
NEXT_PUBLIC_API_TIMEOUT_MS=15000
# Longest pause in ms between two SSE chunks. Keep it above LLM_TIMEOUT_SECONDS.
NEXT_PUBLIC_STREAM_IDLE_TIMEOUT_MS=130000
# 1 turns on the presenter autopilot (hidden shortcuts type the demo prompts).
NEXT_PUBLIC_DEMO_AUTOPILOT=
# Optional local Playwright browser channel, for example chrome. CI uses bundled Chromium.
PLAYWRIGHT_CHANNEL=
# Optional test switches. RUN_LIVE=1 runs document tests against the live LLM. RUN_SLOW=1 runs slow RAG tests.
RUN_LIVE=
RUN_SLOW=
