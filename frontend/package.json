{
  "name": "sv-ki-lotse-frontend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "next typegen && tsc --noEmit",
    "test:unit": "vitest run --passWithNoTests",
    "test:transport": "node --experimental-strip-types --test src/lib/transport/transport.test.ts",
    "demo:check": "playwright test --pass-with-no-tests",
    "api:schema": "node scripts/fetch-openapi.mjs",
    "api:types": "openapi-typescript src/lib/api/generated/openapi.json --output src/lib/api/generated/schema.d.ts",
    "api:generate": "npm run api:schema && npm run api:types"
  },
  "dependencies": {
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "framer-motion": "^12.0.0",
    "lucide-react": "^1.0.0",
    "next": "^16.2.0",
    "radix-ui": "^1.4.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.0",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.0.0"
  },
  "devDependencies": {
    "@playwright/test": "1.64.0",
    "@tailwindcss/postcss": "^4.1.0",
    "@testing-library/dom": "^10.4.0",
    "@testing-library/jest-dom": "^6.6.0",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.0",
    "eslint": "^9.0.0",
    "eslint-config-next": "^16.2.0",
    "jsdom": "^27.0.0",
    "openapi-typescript": "^7.8.0",
    "tailwindcss": "^4.1.0",
    "tw-animate-css": "^1.3.0",
    "typescript": "^5.9.0",
    "vitest": "^4.0.0"
  }
}
